# Forwards, and nothing else:
#   https://<this host>/<PROXY_SECRET>/...                    -> https://openrouter.ai/...
#   https://<this host>/<PROXY_SECRET>/relay/<host>/...       -> https://<host>/...
# where <host> is one of the AI APIs listed below (OpenAI, Anthropic, Google's Gemini API).
#
# It holds no key: the caller sends its own (Authorization, x-api-key), which is passed through.
# The secret path segment only keeps the proxy from being found and used as an open relay.

log_format proxy '$time_iso8601 $status $request_method $request_time $upstream_status';

server {
    listen 80;
    server_tokens off;

    # The request line carries the secret, so it is kept out of the log.
    access_log /dev/stdout proxy;

    # Re-resolved while running rather than once at startup, so a change in OpenRouter's addresses
    # does not need a restart.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
    set $openrouter openrouter.ai;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /${PROXY_SECRET}/ {
        rewrite ^/${PROXY_SECRET}/(.*)$ /$1 break;
        proxy_pass https://$openrouter;

        proxy_ssl_server_name on;
        proxy_ssl_name openrouter.ai;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;

        proxy_set_header Host openrouter.ai;
        proxy_set_header Connection "";

        # The point of the proxy: OpenRouter must see this server, not the original client. Host
        # nginx adds these for every project, so they are cleared rather than passed on.
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";

        # Streamed completions arrive as server-sent events; pass them through as they come.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 20m;
    }

    # The relay: the provider's host is the first path segment after /relay/. Only these hosts;
    # any other gets a 404 (the prefix location below). A regex location wins over the OpenRouter
    # prefix above, so /relay/ paths never reach OpenRouter.
    location ~ ^/${PROXY_SECRET}/relay/(api\.openai\.com|api\.anthropic\.com|generativelanguage\.googleapis\.com)(/.*)$ {
        set $relay_host $1;
        set $relay_path $2;
        proxy_pass https://$relay_host$relay_path$is_args$args;

        proxy_ssl_server_name on;
        proxy_ssl_name $relay_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;

        proxy_set_header Host $relay_host;
        proxy_set_header Connection "";

        # As above: the provider must see this server, not the original client.
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        # The Siteoseo AI service's relay header: meant for this hop only.
        proxy_set_header X-Relay-Key "";

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 20m;
    }

    location /${PROXY_SECRET}/relay/ {
        return 404;
    }

    location / {
        return 404;
    }
}
